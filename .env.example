# ==========================================
# HIKNOWS - Production Environment Variables
# ==========================================

# Next.js & Server
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NODE_ENV=development

# Payload CMS Secrets
# 32+ character random string for JWT and cookie encryption
PAYLOAD_SECRET=hiknows_super_secret_payload_encryption_key_2026_cctv

# Database Configuration (PostgreSQL)
# Format: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/hiknows

# Fallback SQLite for local builds if PostgreSQL is not yet connected
# DATABASE_URI=file:./hiknows-local.db

# Telegram Bot Integration (Server-side notifications)
# Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID or Channel ID (e.g. -1001234567890 or 123456789)
TELEGRAM_CHAT_ID=

# Initial Admin Credentials (used during automatic/first-time seeding)
INITIAL_ADMIN_EMAIL=admin@hiknows.uz
INITIAL_ADMIN_PASSWORD=HiknowsAdmin2026!
INITIAL_ADMIN_NAME="Bosh Administrator"

